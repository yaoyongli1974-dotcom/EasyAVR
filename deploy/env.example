# EasyAVR 生产环境变量模板
#
# 安装位置：/etc/easyavr/env（由 systemd 的 EnvironmentFile 读取，权限建议 0640 root:easyavr）
#   install -d -m 0755 /etc/easyavr
#   install -m 0640 -o root -g easyavr deploy/env.example /etc/easyavr/env
#
# 格式约定（systemd EnvironmentFile）：
#   - 一行一个 KEY=VALUE，等号两侧不要留空格；
#   - 值不要加引号，除非值里确实有空格；
#   - 行尾不能写注释，注释必须单独占一行，否则 # 之后的内容会被当成值的一部分。
#
# 变量名与 server/internal/config/config.go 和根 README.md 的环境变量表一致。

# ---------------------------------------------------------------------------
# 监听与数据库
# ---------------------------------------------------------------------------

# HTTP 监听地址。代码读的是 EASYAVR_LISTEN（不是常被误写的 EASYAVR_ADDR）。
# nginx 反代 127.0.0.1:18000，所以这里绑回环就够了，不要对外监听。
EASYAVR_LISTEN=127.0.0.1:18000

# 数据库驱动：sqlite（默认，单机推荐）或 postgres。
EASYAVR_DB_DRIVER=sqlite

# SQLite 文件路径，相对 WorkingDirectory=/opt/easyavr/server 解析。
EASYAVR_DB=./data/easyavr.db

# PostgreSQL DSN，仅 EASYAVR_DB_DRIVER=postgres 时生效；用 sqlite 时留空。
EASYAVR_DB_DSN=

# PostgreSQL 下用 pgvector 存/查事件向量，扩展缺失时自动退化为普通检索。
EASYAVR_PGVECTOR=true

# ---------------------------------------------------------------------------
# 认证与管理员
# ---------------------------------------------------------------------------

# JWT 签名密钥。生成方式：openssl rand -hex 32
# 默认值 easyavr-dev-secret-change-me 是公开的，生产必须换掉。
EASYAVR_JWT_SECRET=changeme

# JWT 有效期（小时）。
EASYAVR_JWT_EXPIRE_HOURS=24

# 首次启动创建的管理员。默认 easyavr/easyavr 必须改，且只在库为空时生效。
EASYAVR_ADMIN_USER=admin_change_me

# 管理员初始密码，至少 12 位，改完记录到密码管理器。
EASYAVR_ADMIN_PASS=changeme

# 允许的跨域来源。生产只放行自己的前端域名；调试可临时改 * 再改回来。
EASYAVR_ALLOW_ORIGIN=https://app.easyavr.cn

# ---------------------------------------------------------------------------
# 前端与运行期数据目录（相对 WorkingDirectory=/opt/easyavr/server 解析）
# ---------------------------------------------------------------------------

# 前端产物目录，后端直接托管并在 /api/* 之外做 SPA fallback。
EASYAVR_WEB_DIST=../web/dist

# 抓拍图存放目录，/snapshots/* 免鉴权对外提供。
EASYAVR_SNAPSHOT_DIR=./data/snapshots

# 后台流量/状态采样周期（秒），0 表示关闭，关闭后流量统计页无数据。
EASYAVR_MONITOR_SEC=30

# ---------------------------------------------------------------------------
# ZLMediaKit（HTTP API 与播放地址拼接）
# ---------------------------------------------------------------------------

# ZLM 的 HTTP API 地址。生产由 docker-compose.prod.yml 绑在宿主机回环 8080，
# 容器内仍然是 80；宿主机 80 属于 nginx，不能给 ZLM。
EASYAVR_ZLM_API=http://127.0.0.1:8080

# ZLM API secret，必须与 deploy/zlm/config.ini 里的 general.secret 一致。
EASYAVR_ZLM_SECRET=EasyAVRzlmSecret2024x

# 播放地址里给浏览器看的主机名，生产写域名，不要写 IP（换机/加 CDN 时只改 DNS）。
EASYAVR_MEDIA_HOST=app.easyavr.cn

# 播放地址的协议头。页面是 https，媒体也必须是 https，否则浏览器按混合内容拦截。
EASYAVR_MEDIA_SCHEME=https

# 播放地址的端口。走 nginx 443，配合 https 时端口等于默认端口，URL 里不会出现 :443。
EASYAVR_ZLM_HTTP_PORT=443

# RTSP/RTMP 端口保持 ZLM 默认值：这两个协议只给宿主机上的 ffmpeg 转码/抓帧用，
# 生产 compose 把它们绑在 127.0.0.1 上，不对外。播放地址里的 rtsp/rtmp 项
# 因此只在服务器内部可用，浏览器侧走 hls/webrtc。
EASYAVR_ZLM_RTSP_PORT=554
EASYAVR_ZLM_RTMP_PORT=1935

# ---------------------------------------------------------------------------
# 播放白名单与签名
# ---------------------------------------------------------------------------

# 允许申请播放地址的来源域名，逗号分隔（代码里是 envList，按逗号切分）。
# 请求带 Origin 或 Referer 前缀匹配即放行，留空表示不限制。
EASYAVR_PLAY_WHITELIST=https://easyavr.cn,https://www.easyavr.cn,https://app.easyavr.cn

# 打开后播放地址带 HMAC 签名，过期时间由 EASYAVR_PLAY_TOKEN_TTL_MIN 控制。
EASYAVR_PLAY_AUTH=false

# 播放签名有效期（分钟）。
EASYAVR_PLAY_TOKEN_TTL_MIN=60

# ---------------------------------------------------------------------------
# GB28181 国标接入（关闭时不监听 5060，/gb/config 返回 enabled:false）
# ---------------------------------------------------------------------------

EASYAVR_GB_ENABLED=false

# SIP 信令 UDP 监听地址。
EASYAVR_GB_LISTEN=:5060

# 平台 SIP 编码，20 位数字。
EASYAVR_GB_ID=34020000002000000001

# SIP 域 / Realm。
EASYAVR_GB_REALM=3402000000

# 设备注册用的摘要鉴权密码，与设备端配置保持一致。
EASYAVR_GB_PASSWORD=changeme

# SDP 里通告给设备的收流 IP，必须是设备能访问到的地址（公网 IP）。
EASYAVR_GB_RTP_IP=152.32.135.156

# 收流端口范围，与 ZLM 的 [rtp_proxy] port_range 及防火墙放通范围对齐。
EASYAVR_GB_RTP_PORT_LOW=30000
EASYAVR_GB_RTP_PORT_HIGH=30500

# ---------------------------------------------------------------------------
# 以下接入端点默认挂在 JWT 之外，公网实例保持关闭，确需开启时先加 IP 白名单
# ---------------------------------------------------------------------------

# GA/T1400（VIID）XML 入库端点 /VIID/*。
EASYAVR_GA1400_ENABLED=false

# EHOME/ISUP（海康）UDP 接入。
EASYAVR_EHOME_ENABLED=false

# GB35114 国密接入（平台 CA、证书签发、GM/T 0024 安全 SIP）。
EASYAVR_GB35114_ENABLED=false

# 平台 CA / 设备证书目录，位于 ReadWritePaths 覆盖的 server/data 下。
EASYAVR_GB35114_CERT_DIR=./data/gb35114-certs

# 集群与地图：单机部署保持默认即可
EASYAVR_CLUSTER_ENABLED=false
EASYAVR_AMAP_KEY=
